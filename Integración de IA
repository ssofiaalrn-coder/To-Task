3. Une la lógica con la función sonsultarAsistenteEstudio
const base = abiertas.slice(0, 80).concat(completadas.slice(-30));
const contexto = base.map((t, i) => ({ id: i, codigo: t.codigo, titulo: t.titulo, ... }));

const prompt = [
  "Eres el asistente académico de la app To-Task...",
  `Fecha de hoy: ${hoy}`,
  "Cuando hables de las tareas, usa únicamente los datos del JSON; no inventes...",
  `Tareas del estudiante: ${JSON.stringify(contexto)}`,
  `Pregunta del estudiante: ${texto}`,
  "Devuelve un JSON con: 'respuesta' e 'ids'..."
].join("\n\n");

llamarGemini(prompt, apiKey, {
  responseMimeType: "application/json",
  responseSchema: {
    type: "OBJECT",
    properties: {
      respuesta: { type: "STRING" },
      ids: { type: "ARRAY", items: { type: "INTEGER" } }
    },
    required: ["respuesta", "ids"]
  }
});

const json = JSON.parse(resultado.texto);
tareas = json.ids.map(id => base[id]).filter(Boolean).slice(0, 15);
return { respuesta: json.respuesta, tareasRelacionadas: tareas };

